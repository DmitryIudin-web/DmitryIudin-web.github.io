{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 scripts/generate_sitemap.py)",
      "Bash(python3 scripts/sync_agent_docs.py)",
      "Bash(python3 scripts/sync_agent_docs.py --check)",
      "Bash(python3 scripts/indexnow_ping.py *)",
      "Bash(python3 -c *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(file *)"
    ],
    "deny": [
      "Edit(sitemap-0.xml)",
      "Edit(sitemap-index.xml)",
      "Edit(frozen-assets/**)",
      "Edit(_astro/**)",
      "Edit(assets/**)",
      "Edit(AGENTS.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-agents-mirror.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-agents-mirror.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
