# ~/.hermes/.env — секреты Hermes Agent. Файл живёт ТОЛЬКО на сервере (chmod 600).
# Никогда не коммитить заполненный файл: корень репозитория публикуется на avtonds.ru.

# --- Telegram-шлюз -----------------------------------------------------------
# Токен от @BotFather (/newbot). Если утёк — /revoke в BotFather и новый токен.
TELEGRAM_BOT_TOKEN=
# Числовой ID владельца (узнать: написать @userinfobot). Через запятую — несколько.
# Без этой строки бот не отвечает никому — это и есть защита "бот только для меня".
TELEGRAM_ALLOWED_USERS=
# Куда слать результаты кронов (обычно тот же личный чат = ваш user ID).
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=Дмитрий (личка)

# --- Модель ("чем он думает") -----------------------------------------------
# Заполните ОДИН вариант и выберите модель командой `hermes model`.
# Kimi / Moonshot (provider: kimi-coding) — ключ из консоли platform.moonshot.ai
KIMI_API_KEY=
# OpenRouter (provider: openrouter) — любая модель через один ключ
OPENROUTER_API_KEY=
# Anthropic по API-ключу (pay-per-token). Подписка Claude Pro через OAuth НЕ работает,
# OAuth доступен только на Claude Max с докупленными extra-usage кредитами.
ANTHROPIC_API_KEY=
# Подписка ChatGPT/Codex подключается без ключа: `hermes model` → "ChatGPT or Codex Subscription".

# --- Голосовые сообщения (распознавание) --------------------------------------
# Локальный faster-whisper настраивается в config.yaml (stt.provider: local).
# Язык по умолчанию для распознавания:
HERMES_LOCAL_STT_LANGUAGE=ru
# Альтернатива без нагрузки на сервер — Groq Whisper (бесплатный тариф есть):
# GROQ_API_KEY=

# --- Работа с GitHub (репозиторий сайта) --------------------------------------
# Fine-grained token только на нужные репозитории, права contents+pull_requests.
# GH_TOKEN=
