# HERMES_HOME/.env — секреты Hermes Agent в приватном профиле Windows или VPS.
# На Linux chmod 600; на Windows доступ только владельцу через ACL.
# Никогда не коммитить заполненный файл: корень репозитория публикуется на avtonds.ru.

# --- Telegram-шлюз -----------------------------------------------------------
# Токен от @BotFather (/newbot). Если утёк — /revoke в BotFather и новый токен.
TELEGRAM_BOT_TOKEN=
# Числовой ID владельца (узнать: написать @userinfobot). Через запятую — несколько.
# Заполните allowlist и отдельно проверьте авторизацию выбранной версии gateway.
TELEGRAM_ALLOWED_USERS=
# Куда слать результаты кронов (обычно тот же личный чат = ваш user ID).
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=Дмитрий (личка)

# --- Модель ("чем он думает") -----------------------------------------------
# Заполните ОДИН вариант и выберите модель командой `hermes model`.
# Kimi: провайдер и тип ключа должны соответствовать варианту в `hermes model`.
KIMI_API_KEY=
# OpenRouter (provider: openrouter) — любая модель через один ключ
OPENROUTER_API_KEY=
# Anthropic по API-ключу. Условия оплаты/авторизации проверяются у провайдера.
ANTHROPIC_API_KEY=
# Другие варианты авторизации подключаются мастером `hermes model`.

# --- Голосовые сообщения (распознавание) --------------------------------------
# Локальный faster-whisper настраивается в config.yaml (stt.provider: local).
# Язык по умолчанию для распознавания:
HERMES_LOCAL_STT_LANGUAGE=ru
# Альтернатива без нагрузки на сервер — Groq Whisper (бесплатный тариф есть):
# GROQ_API_KEY=

# --- GitHub -----------------------------------------------------------------
# Публичный репозиторий читается без токена. Комплект не выдаёт агенту права
# публикации. Commit передаётся владельцу; GitHub-аутентификация остаётся
# в его отдельном контуре, вне профиля агента.
